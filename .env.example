NEXT_PUBLIC_APP_NAME= "" 
NEXT_PUBLIC_API_URL= ""
NEXTAUTH_SECRET= ""
NEXT_PUBLIC_NEXTAUTH_SECRET= ""
NEXTAUTH_JWT_SECRET= ""
NEXTAUTH_URL =""
NODE_ENV =""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY= ""
STRIPE_CONNECT_ACCOUNT_ID = "" 
ANALYZE= ""
NEXT_PUBLIC_DOMAIN_TEST = ""
DATABASE_URI=""
PAYLOAD_SECRET=""
PAYLOAD_CMS_ENABLED="false"
# Exact origin used to open CMS (no /cms-admin path). Set the deployed origin in production.
PAYLOAD_SERVER_URL="http://localhost:3001"

# Payload media storage. When S3_BUCKET is empty, local development uses /media.
S3_BUCKET="caskexchange-cms-storage"
S3_REGION="us-east-1"
# Optional folder inside the bucket, for example staging or production.
S3_PREFIX=""
# Leave credentials empty on ECS when using an IAM task role.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional for Neon Storage, R2, MinIO, or another S3-compatible provider.
S3_ENDPOINT=""
# Set true when using a Neon branch storage endpoint.
S3_FORCE_PATH_STYLE="false"

# Playwright E2E Testing Credentials
E2E_USER_EMAIL=""
E2E_USER_PASSWORD=""
# Optional: if the test user has 2FA enabled
# E2E_OTP_CODE=""
